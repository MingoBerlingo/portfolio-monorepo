{
  "name": "curriculum",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.mjs",
    "test:smoke": "node scripts/editor.e2e.mjs",
    "preview": "node scripts/start.mjs",
    "pdf": "node --import tsx src/cli.ts pdf",
    "dev": "vite dev --host 127.0.0.1 --port 4174 --strictPort",
    "test:e2e": "node scripts/editor.e2e.mjs",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "start": "node scripts/start.mjs",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@dnd-kit/svelte": "^0.5.3",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.43.5",
    "playwright": "1.55.1",
    "svelte": "^5.39.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vite": "^7"
  }
}
