# Base URL of the Payload CMS instance (no trailing slash).
# Used at build time by `pnpm build:site` to pull content + media from the CMS.
# Defaults to http://localhost:3000 if not set
CMS_API_URL=http://localhost:3000

# Subpath the site is hosted under (leading slash, no trailing slash).
# Leave empty when hosting at the domain root (e.g. a custom domain or a
# `<user>.github.io` user/org site). `pnpm publish:pages` sets this
# automatically; you only need it for manual builds/test.
# Example for a GitHub Pages project site: BASE_PATH=/portfolio-monorepo
# BASE_PATH=
