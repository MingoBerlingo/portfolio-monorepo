{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "description": "A modern monorepo built with PNPM workspaces, featuring SvelteKit applications and shared packages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel --filter './apps/*' dev",
    "build": "pnpm run --recursive build",
    "test": "pnpm run --recursive test",
    "lint": "pnpm run --recursive lint",
    "format": "pnpm run --recursive format",
    "clean": "pnpm run --recursive clean && rm -rf node_modules/.cache",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:preview": "pnpm --filter web preview",
    "web:storybook": "pnpm --filter web storybook",
    "web:build-storybook": "pnpm --filter web build-storybook",
    "build:site": "bash scripts/build-site.sh",
    "publish:pages": "bash scripts/publish-pages.sh",
    "cms:dev": "pnpm --filter cms dev",
    "cms:build": "pnpm --filter cms build",
    "cms:start": "pnpm --filter cms start",
    "cms:payload": "pnpm --filter cms payload",
    "cms:generate:types": "pnpm --filter cms generate:types",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "monorepo",
    "pnpm",
    "svelte",
    "sveltekit",
    "storybook",
    "typescript",
    "payload",
    "cms",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.17"
  }
}